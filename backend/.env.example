# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
DB_NAME=prescripto

# JWT
JWT_SECRET=your_jwt_secret_here

# Cloudinary
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payments
# Currency should be a valid ISO currency code (e.g., INR, USD). Will be lowercased at runtime.
CURRENCY=INR

# Stripe - REQUIRED for Stripe payments
# Use your Stripe Secret Key (starts with sk_live_ for production or sk_test_ for test)
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Razorpay - REQUIRED for Razorpay payments
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Admin Login (server-side)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
